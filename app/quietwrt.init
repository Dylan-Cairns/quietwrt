#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

start_service() {
  [ -x /usr/bin/quietwrtctl ] || return 0

  procd_open_instance
  procd_set_param command /bin/sh -c 'sleep 15; /usr/bin/quietwrtctl boot-check >/tmp/quietwrt-boot-reconcile.log 2>&1; code=$?; cat /tmp/quietwrt-boot-reconcile.log; exit $code'
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}
